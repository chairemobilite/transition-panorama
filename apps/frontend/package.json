{
    "name": "frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "build": "tsc -b && vite build",
        "check": "yarn check:format && yarn check:i18n && yarn check:lint && yarn build",
        "check:format": "prettier . --check",
        "check:i18n": "i18next-cli lint && i18next-cli extract --ci --dry-run && i18next-cli status",
        "check:lint": "eslint .",
        "dev": "vite",
        "fix": "yarn fix:i18n && yarn fix:lint && yarn fix:format",
        "fix:format": "prettier . -w",
        "fix:i18n": "i18next-cli extract",
        "fix:lint": "eslint . --fix",
        "preview": "vite preview"
    },
    "prettier": "dev-config/prettier",
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@fontsource-variable/inter": "^5.3.0",
        "@phosphor-icons/react": "^2.1.10",
        "@tailwindcss/vite": "^4.3.5",
        "@tanstack/react-query": "^5.108.4",
        "@tanstack/react-router": "^1.170.46",
        "@turf/turf": "^7.4.0",
        "@vis.gl/react-maplibre": "^8.1.3",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.5.2",
        "colorjs.io": "^0.7.1",
        "contract": "workspace:*",
        "i18next": "^27.2.7",
        "i18next-browser-languagedetector": "^8.3.1",
        "maplibre-gl": "^6.19.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-i18next": "^18.0.3",
        "shadcn": "^4.23.0",
        "tailwindcss": "^4.3.5",
        "tw-animate-css": "^1.4.0",
        "use-debounce": "^10.1.1",
        "utils": "workspace:*",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@babel/core": "^7.29.13",
        "@rolldown/plugin-babel": "^0.3.1",
        "@tanstack/eslint-plugin-router": "^1.162.0",
        "@tanstack/router-plugin": "^1.169.0",
        "@tsconfig/strictest": "2.0.9",
        "@types/babel__core": "^7.20.5",
        "@types/node": "24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "dev-config": "workspace:*",
        "eslint": "^10.15.0",
        "eslint-plugin-better-tailwindcss": "^4.11.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.8",
        "globals": "^17.14.0",
        "i18next-cli": "^1.95.1",
        "jiti": "^2.7.0",
        "prettier": "3.10.1",
        "typescript": "6.0.3",
        "vite": "^8.3.8",
        "yaml": "^2.9.1"
    }
}
