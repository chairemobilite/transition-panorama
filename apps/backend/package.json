{
    "name": "backend",
    "version": "0.0.0",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "build": "tsc && node build.ts",
        "check": "yarn check:format && yarn check:lint && yarn test && yarn build",
        "check:format": "prettier . --check",
        "check:lint": "eslint .",
        "dev": "tsx watch --env-file=../../.env --include ../../config.public.yaml src/index.ts",
        "fix": "yarn fix:lint && yarn fix:format",
        "fix:format": "prettier . -w",
        "fix:lint": "eslint . --fix",
        "start": "node --env-file=../../.env dist/index.js",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "prettier": "dev-config/prettier",
    "devDependencies": {
        "@tsconfig/node24": "24.0.6",
        "@tsconfig/strictest": "2.0.9",
        "@types/express": "^5.0.6",
        "@types/node": "24.19.2",
        "@vitest/coverage-v8": "^5.1.1",
        "dev-config": "workspace:*",
        "esbuild": "^0.28.2",
        "eslint": "^10.15.0",
        "globals": "^17.14.0",
        "jiti": "^2.7.0",
        "msw": "^3.0.7",
        "prettier": "3.10.1",
        "tsx": "^4.23.15",
        "typescript": "6.0.3",
        "vite": "^8.3.8",
        "vitest": "^5.1.1"
    },
    "dependencies": {
        "@turf/turf": "^7.4.0",
        "contract": "workspace:*",
        "express": "^5.3.0",
        "geocoder": "workspace:*",
        "transition-client": "workspace:*",
        "utils": "workspace:*",
        "yaml": "^2.9.1",
        "zod": "4.6.7"
    }
}
