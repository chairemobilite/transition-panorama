{
    "name": "backend",
    "version": "0.0.0",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "build": "tsc && node build.ts",
        "check": "yarn check:format && yarn check:lint && yarn test && yarn build",
        "check:format": "prettier . --check",
        "check:lint": "eslint .",
        "codegen": "orval",
        "dev": "tsx watch --env-file=../.env --include ../config.public.yaml src/index.ts",
        "fix": "yarn fix:lint && yarn fix:format",
        "fix:format": "prettier . -w",
        "fix:lint": "eslint . --fix",
        "start": "node --env-file=../.env dist/index.js",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@eslint/markdown": "^8.0.3",
        "@tsconfig/node24": "24.0.5",
        "@tsconfig/strictest": "2.0.8",
        "@types/express": "^5.0.6",
        "@types/node": "26.6.2",
        "@vitest/coverage-v8": "^5.0.3",
        "esbuild": "^0.28.2",
        "eslint": "^10.11.0",
        "globals": "^17.12.0",
        "jiti": "^2.7.0",
        "msw": "^2.15.0",
        "orval": "^8.37.0",
        "prettier": "3.9.9",
        "tsx": "^4.23.15",
        "typescript": "6.0.3",
        "typescript-eslint": "^8.70.1",
        "vite": "^8.3.0",
        "vitest": "^5.0.3"
    },
    "dependencies": {
        "@turf/turf": "^7.4.0",
        "common": "workspace:*",
        "express": "^5.2.1",
        "yaml": "^2.9.1",
        "zod": "4.6.5"
    }
}
