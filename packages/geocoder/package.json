{
    "name": "geocoder",
    "version": "0.0.0",
    "private": true,
    "license": "MIT",
    "type": "module",
    "scripts": {
        "check": "yarn check:format && yarn check:lint && yarn test && tsc --noEmit",
        "check:format": "prettier . --check",
        "check:lint": "eslint .",
        "dev": "vite playground",
        "fix": "yarn fix:lint && yarn fix:format",
        "fix:format": "prettier . -w",
        "fix:lint": "eslint . --fix",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "prettier": "dev-config/prettier",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        }
    },
    "dependencies": {
        "utils": "workspace:*",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.5",
        "@tanstack/react-query": "^5.108.4",
        "@tsconfig/strictest": "2.0.9",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "@vitest/coverage-v8": "^5.1.1",
        "dev-config": "workspace:*",
        "eslint": "^10.15.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.14.0",
        "jiti": "^2.7.0",
        "msw": "^3.0.7",
        "prettier": "3.10.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tailwindcss": "^4.3.5",
        "typescript": "6.0.3",
        "use-debounce": "^10.1.1",
        "vite": "^8.3.8",
        "vitest": "^5.1.1",
        "yaml": "^2.9.1"
    }
}
