{
    "name": "transition-client",
    "version": "0.0.0",
    "private": true,
    "license": "MIT",
    "type": "module",
    "scripts": {
        "check": "yarn check:format && yarn check:lint && yarn test && tsc --noEmit",
        "check:format": "prettier . --check",
        "check:lint": "eslint .",
        "codegen": "orval",
        "fix": "yarn fix:lint && yarn fix:format",
        "fix:format": "prettier . -w",
        "fix:lint": "eslint . --fix",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "prettier": "dev-config/prettier",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        }
    },
    "dependencies": {
        "utils": "workspace:*",
        "zod": "4.6.5"
    },
    "devDependencies": {
        "@tsconfig/node24": "24.0.5",
        "@tsconfig/strictest": "2.0.8",
        "@types/node": "26.6.2",
        "@vitest/coverage-v8": "^5.0.3",
        "dev-config": "workspace:*",
        "eslint": "^10.11.0",
        "globals": "^17.12.0",
        "jiti": "^2.7.0",
        "msw": "^2.15.0",
        "orval": "^8.37.0",
        "prettier": "3.9.9",
        "typescript": "6.0.3",
        "vite": "^8.3.0",
        "vitest": "^5.0.3"
    }
}
