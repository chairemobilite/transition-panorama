{
    "name": "dev-config",
    "version": "0.0.0",
    "private": true,
    "license": "MIT",
    "type": "module",
    "scripts": {
        "check": "yarn check:format && yarn check:lint && tsc --noEmit",
        "check:format": "prettier . --check",
        "check:lint": "eslint .",
        "fix": "yarn fix:lint && yarn fix:format",
        "fix:format": "prettier . -w",
        "fix:lint": "eslint . --fix"
    },
    "exports": {
        "./eslint": "./eslint.ts",
        "./prettier": "./prettier.json"
    },
    "prettier": "./prettier.json",
    "dependencies": {
        "@eslint/js": "^10.0.1",
        "@eslint/markdown": "^9.0.0",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-check-file": "^3.3.2",
        "eslint-plugin-import-x": "^4.18.1",
        "typescript-eslint": "^8.74.0"
    },
    "peerDependencies": {
        "eslint": "^10.0.0",
        "typescript": "^6.0.0"
    },
    "devDependencies": {
        "@tsconfig/strictest": "2.0.9",
        "@types/node": "24.19.2",
        "eslint": "^10.15.0",
        "globals": "^17.14.0",
        "jiti": "^2.7.0",
        "prettier": "3.10.1",
        "typescript": "6.0.3"
    }
}
